.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ===== IntelliJ IDEA =====
.idea/
*.iml
*.iws
*.ipr
out/

# ===== VS Code =====
.vscode/
.classpath
.project
.settings/

# ===== Eclipse =====
*.classpath
*.project
*.settings/
bin/

